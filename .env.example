# Root environment for the API, worker, and Docker Compose web build.
# Copy to .env. For `npm run dev --workspace=@formwise/web`, also copy
# apps/web/.env.local.example to apps/web/.env.local.

# Required local Firebase configuration. These are used for Firebase Auth and
# Firestore metadata only; Firebase Storage is not used.
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# Set exactly one service-account source for API and worker:
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/firebase-service-account.json

# Required to create signed local upload-intent URLs. Generate a unique random value.
UPLOAD_SIGNING_SECRET=replace-with-a-long-random-local-secret

# Required by the web application; values come from Firebase Console → Web app.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Local runtime defaults. All document artifacts remain on the local filesystem.
FORMWISE_ENV=development
LOG_LEVEL=INFO
LOCAL_STORAGE_PATH=storage/uploads
QUARANTINE_STORAGE_PATH=storage/quarantine
OCR_RESULT_STORAGE_PATH=storage/ocr
PRIVACY_RESULT_STORAGE_PATH=storage/privacy
RENDER_OUTPUT_STORAGE_PATH=storage/renders

# Ollama is required only for Safe Chat. Use localhost for direct API/worker runs;
# set http://ollama:11434 when API/worker run in Docker Compose with the ollama profile.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Optional tuning and operational settings; defaults in code match these values.
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
CORS_ALLOWED_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOWED_HEADERS=["Authorization","Content-Type","Origin","Accept","Idempotency-Key","X-Request-ID"]
OCR_PROVIDER=paddleocr
PRIVACY_POLICY_VERSION=v1
UNDERSTANDING_PROVIDER_VERSION=deterministic-v1
RENDER_COORDINATE_CONFIDENCE_THRESHOLD=0.85
OCR_WORKER_POLL_SECONDS=2
WORKER_MAX_CONCURRENCY=3
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BACKOFF_SECONDS=2
WORKER_RETRY_BACKOFF_MAX_SECONDS=60
OCR_TIMEOUT_SECONDS=120
RETENTION_TIMEOUT_SECONDS=120
WORKER_HEARTBEAT_SECONDS=15
WORKER_INSTANCE_ID=local-worker
